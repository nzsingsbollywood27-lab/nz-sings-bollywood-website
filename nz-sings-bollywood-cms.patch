+import { useEffect,useState } from "react";
+import { ADMIN_UID,supabase } from "../lib/supabase";
+import { defaultContent,mergeContent } from "../cms/defaultContent";
+import "./admin.css";
+const TYPES=["image/jpeg","image/png","image/webp","image/gif"],MAX=5*1024*1024;
+export function AdminPage(){const[session,setSession]=useState(null),[loading,setLoading]=useState(true),[email,setEmail]=useState(""),[password,setPassword]=useState(""),[saved,setSaved]=useState(defaultContent),[json,setJson]=useState(JSON.stringify(defaultContent,null,2)),[message,setMessage]=useState(""),[busy,setBusy]=useState(false);useEffect(()=>{supabase.auth.getSession().then(({data})=>{setSession(data.session);setLoading(false)});const{data}=supabase.auth.onAuthStateChange((_e,s)=>setSession(s));return()=>data.subscription.unsubscribe()},[]);useEffect(()=>{if(session?.user?.id===ADMIN_UID)supabase.from("cms_documents").select("content").eq("id","site").maybeSingle().then(({data})=>{const n=mergeContent(defaultContent,data?.content);setSaved(n);setJson(JSON.stringify(n,null,2))})},[session]);const login=async e=>{e.preventDefault();setBusy(true);setMessage("");const{data,error}=await supabase.auth.signInWithPassword({email:email.trim(),password});if(!error&&data.user?.id!==ADMIN_UID){await supabase.auth.signOut();setMessage("This account is not authorised to administer the site.")}else setMessage(error?.message||"Signed in successfully.");setBusy(false)};const save=async()=>{setBusy(true);setMessage("");try{const next=JSON.parse(json);const{error}=await supabase.from("cms_documents").upsert({id:"site",content:next,is_published:true,updated_at:new Date().toISOString(),updated_by:session.user.id});if(error)throw error;setSaved(next);setMessage("Published successfully.")}catch(e){setMessage(e.message)}setBusy(false)};const upload=async e=>{const f=e.target.files?.[0];if(!f)return;if(!TYPES.includes(f.type)||f.size>MAX){setMessage("Choose a JPEG, PNG, WebP or GIF no larger than 5 MB.");return}setBusy(true);const path=`uploads/${Date.now()}-${f.name.replace(/[^a-zA-Z0-9._-]/g,"-")}`;const{error}=await supabase.storage.from("cms-images").upload(path,f,{contentType:f.type,upsert:false});if(error)setMessage(error.message);else{const{data}=supabase.storage.from("cms-images").getPublicUrl(path);await navigator.clipboard?.writeText(data.publicUrl);setMessage(`Uploaded. URL copied: ${data.publicUrl}`)}setBusy(false);e.target.value=""};if(loading)return <main className="admin-shell"><p>Checking session…</p></main>;if(!session)return <main className="admin-shell" data-cms-ignore><form className="admin-card" onSubmit={login}><h1>Website administration</h1><p>Sign in with the approved administrator account.</p><label>Email<input type="email" value={email} onChange={e=>setEmail(e.target.value)} required autoComplete="username"/></label><label>Password<input type="password" value={password} onChange={e=>setPassword(e.target.value)} required autoComplete="current-password"/></label><button disabled={busy}>{busy?"Signing in…":"Sign in"}</button>{message&&<p role="alert">{message}</p>}</form></main>;if(session.user.id!==ADMIN_UID)return <main className="admin-shell"><p>Unauthorised.</p><button onClick={()=>supabase.auth.signOut()}>Sign out</button></main>;return <main className="admin-shell" data-cms-ignore><header className="admin-toolbar"><div><h1>NZ Sings Bollywood CMS</h1><p>Manage all site content; bundled content remains the fallback.</p></div><button className="secondary" onClick={()=>supabase.auth.signOut()}>Log out</button></header><section className="admin-card"><h2>Image library</h2><p>Upload, then paste the copied URL into an image field or imageOverrides. Unique names make replacement safe.</p><input type="file" accept={TYPES.join(",")} onChange={upload} disabled={busy}/></section><section className="admin-card"><h2>Published content</h2><p>Edit site/event text, tickets, navigation, social links, organisers, partners, supporters, team, FAQs, news and footer data. textOverrides maps exact visible fallback text to replacements; imageOverrides maps original paths to uploaded URLs.</p><textarea aria-label="CMS content JSON" value={json} onChange={e=>setJson(e.target.value)} spellCheck="false"/><div className="admin-actions"><button onClick={save} disabled={busy}>{busy?"Saving…":"Validate and publish"}</button><button className="secondary" onClick={()=>setJson(JSON.stringify(saved,null,2))}>Discard edits</button></div>{message&&<p role="status" className="admin-message">{message}</p>}</section></main>}
